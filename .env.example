# Source de données : "demo" (aucune clé API requise) ou "pappers"
DATA_SOURCE=demo

# Connexion PostgreSQL (cache de l'ingestion, lu par Streamlit)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/broker_immo

# Clé API Pappers Immobilier (header api-key). Requise uniquement si
# DATA_SOURCE=pappers. Ne jamais committer la vraie valeur.
PAPPERS_IMMO_API_KEY=

# Nombre de jours avant qu'une parcelle en cache soit réinterrogée.
CACHE_TTL_DAYS=30

# Garde-fou de consommation de jetons par run d'ingestion.
MAX_CREDITS_PER_RUN=500

# Réglages du client HTTP Pappers Immobilier (facultatifs, valeurs par
# défaut raisonnables).
PAPPERS_IMMO_TIMEOUT_SECONDS=10
PAPPERS_IMMO_MAX_RETRIES=3
PAPPERS_IMMO_RETRY_BACKOFF_SECONDS=1
